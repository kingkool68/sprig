<?xml version="1.0"?>
<ruleset name="Sprig">
	<description>WordPress Coding Standards for Sprig</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- esc_xml() was added in WordPress 5.5. -->
	<config name="minimum_wp_version" value="5.5"/>

	<rule ref="WordPress"/>

	<!-- Sprig's public hooks use slashes, e.g. sprig/twig/filters. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sprig"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sprig"/>
			</property>
		</properties>
	</rule>
</ruleset>
